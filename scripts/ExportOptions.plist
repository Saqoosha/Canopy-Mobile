<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode 15.3 renamed this from `app-store`. -->
	<key>method</key>
	<string>app-store-connect</string>
	<!-- `export`, not `upload`: the .ipa is handed to `asc builds upload`,
	     which reports a trustworthy exit code and can wait for processing.
	     xcodebuild's own upload works too (no issuer ID needed, it uses the
	     Apple ID signed in to Xcode) but rides altool, whose Xcode 26 error
	     reporting is known to return HTTP 500 after a successful upload. -->
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>VCFY2GFR89</string>
	<key>uploadSymbols</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
	<!-- The build number is passed to `xcodebuild archive` instead, so Xcode
	     must not rewrite it here. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
